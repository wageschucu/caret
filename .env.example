# Copy to .env. Credentials stay in the local helper process.
PORT=4317
# Demo mode is automatic when no TypeSafe key is configured.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Any OpenAI-compatible chat-completions service, including a local server.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
COMPLETER_MODEL=


# Ghost-text deadline in ms; spec target 200, raise for slower local models.
COMPLETER_BUDGET_MS=
# Override only if TypeSafe moves the Jev endpoint.
JEV_ENDPOINT=
