# Copy to .env. Credentials stay in the local helper process.
PORT=4317
# Demo mode is automatic when no TypeSafe key is configured.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Any OpenAI-compatible chat-completions service, including a local server.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
COMPLETER_MODEL=
# Empty model settings are filled at startup from the models Ollama already has (smallest for the
# completer, largest for the executor). Nothing is downloaded. Set to "false" to turn that off.
OLLAMA_AUTODETECT=


# Ghost-text deadline in ms; spec target 200, raise for slower local models.
COMPLETER_BUDGET_MS=
# Override only if TypeSafe moves the Jev endpoint.
JEV_ENDPOINT=
# Context window for a local Ollama executor (tokens); planning prompts with lookups need ~8k.
LLM_NUM_CTX=
# Executor provider: leave empty for the local/OpenAI-compatible endpoint above, or "anthropic" for the
# official Anthropic API (credentials from ANTHROPIC_API_KEY or `ant auth login`); LLM_MODEL is then a Claude model id.
EXECUTOR_PROVIDER=
# Local model used when the hosted executor is unavailable (no credits, offline).
LLM_FALLBACK_MODEL=llama3.1:8b
